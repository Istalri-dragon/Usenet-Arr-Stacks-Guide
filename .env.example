# =============================================================================
#  .env — copy this file to ".env" and edit the values below.
#         (cp .env.example .env)
#  docker compose reads this automatically. Never commit your real .env.
# =============================================================================

# --- Who the apps run as -----------------------------------------------------
# DO NOT just leave these at 1000. Find YOUR real values by running:  id
# You'll see something like:  uid=1000(you) gid=1000(you)
# On Unraid it's 99 / 100. On Synology it's something else. Use what `id` says.
PUID=1000
PGID=1000

# --- Timezone ----------------------------------------------------------------
# Use a "TZ database" name, e.g. America/New_York, Europe/London, UTC.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# --- Where app configs live (small, frequently-written; keep on fast disk) ---
# Each app gets its own subfolder under here automatically (e.g. /appdata/radarr).
APPDATA=/appdata

# --- The single shared data root (downloads + media live UNDER this) ---------
# This MUST be one filesystem. See the README, "The folder structure".
DATA=/data

# --- Plex only ---------------------------------------------------------------
# Only needed if you switch from Jellyfin to Plex in docker-compose.yml.
# Get a fresh token from https://www.plex.tv/claim RIGHT before you start it —
# it expires in about 4 minutes.
PLEX_CLAIM=